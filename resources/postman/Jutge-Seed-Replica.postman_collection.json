  "item": [
    {
      "name": "01. Register Profesor (pre-request)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts = Date.now();",
              "const username = `prof_postman_${ts}`;",
              "const email = `${username}@example.com`;",
              "pm.collectionVariables.set('teacherCandidateUsername', username);",
              "pm.collectionVariables.set('teacherCandidateEmail', email);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Register profesor candidato OK', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Role registrado es student', function () { pm.expect(data.role).to.eql('student'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{teacherCandidateUsername}}\",\n  \"email\": \"{{teacherCandidateEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        }
      }
    },
