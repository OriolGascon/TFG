{
  "info": {
    "_postman_id": "f4f52f8a-6ec9-4d50-8f44-4d4c818f7771",
    "name": "Jutge Register",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección mínima para probar registro de usuario (POST /users). Genera username/email únicos automáticamente."
  },
  "variable": [
    {
      "key": "registerPassword",
      "value": "pass123"
    },
    {
      "key": "registerUsername",
      "value": ""
    },
    {
      "key": "registerEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Register user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts = Date.now();",
              "const username = `alumno_${ts}`;",
              "const email = `${username}@example.com`;",
              "pm.collectionVariables.set('registerUsername', username);",
              "pm.collectionVariables.set('registerEmail', email);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Devuelve id', function () { pm.expect(data.id).to.be.a('number'); });",
              "pm.test('Username coincide', function () { pm.expect(data.username).to.eql(pm.collectionVariables.get('registerUsername')); });",
              "pm.test('Email coincide', function () { pm.expect(data.email).to.eql(pm.collectionVariables.get('registerEmail')); });",
              "pm.test('Role por defecto student', function () { pm.expect(data.role).to.eql('student'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    }
  ]
}
