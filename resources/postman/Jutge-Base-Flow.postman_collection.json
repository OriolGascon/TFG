    {
      "name": "11. Leaderboard assert A=2 B=1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/leaderboard",
          "host": ["{{baseUrl}}"],
          "path": ["leaderboard"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Leaderboard responde 200', function () { pm.response.to.have.status(200); });",
              "const rows = pm.response.json();",
              "const aUser = pm.environment.get('studentAUsername');",
              "const bUser = pm.environment.get('studentBUsername');",
              "const a = rows.find(r => r.username === aUser);",
              "const b = rows.find(r => r.username === bUser);",
              "pm.test('Alumno A existe en leaderboard', function () { pm.expect(a).to.not.be.undefined; });",
              "pm.test('Alumno B existe en leaderboard', function () { pm.expect(b).to.not.be.undefined; });",
              "pm.test('Alumno A completados = 2', function () { pm.expect(a.completed_count).to.eql(2); });",
              "pm.test('Alumno B completados = 1', function () { pm.expect(b.completed_count).to.eql(1); });"
            ],
            "type": "text/javascript"
          }
        }
