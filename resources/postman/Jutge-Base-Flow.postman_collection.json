    },
    {
      "name": "04. Poll Job A sum",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobA_sum}}",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{jobA_sum}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Poll A sum responde 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "if (data.status === 'pending' || data.status === 'evaluating') {",
              "  postman.setNextRequest('04. Poll Job A sum');",
              "} else {",
              "  pm.test('A sum termina completed', function () { pm.expect(data.status).to.eql('completed'); });",
              "  pm.test('A sum verdict AC', function () { pm.expect(data.verdict).to.eql('AC'); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
