    "name": "Jutge Base Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Replica el flujo de dev-tools/test_base_flow_api.py: A resuelve sum+sort, B resuelve sum y falla sort; valida leaderboard A=2/B=1. Usuarios estáticos: alumno_a_base / alumno_b_base."
  },
  "item": [
    {
      "name": "01. Login Alumno A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{studentAUsername}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{studentPassword}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": ["{{baseUrl}}"],
          "path": ["token"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login A OK', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.environment.set('tokenA', data.access_token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
