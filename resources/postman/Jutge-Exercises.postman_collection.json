{
  "info": {
    "_postman_id": "7cf6c5fe-2a6c-4d5e-9f7a-4d1fbda3a621",
    "name": "Jutge Exercises",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Flujo de ejercicios: login -> GET /exercises -> GET /exercises/{id} con id dinámica"
  },
  "variable": [
    {
      "key": "firstExerciseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Login Alumno A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{studentAUsername}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{studentPassword}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.environment.set('tokenA', data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. GET /exercises",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/exercises",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "exercises"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Exercises 200', function () { pm.response.to.have.status(200); });",
              "const rows = pm.response.json();",
              "pm.test('Exercises es array', function () { pm.expect(Array.isArray(rows)).to.eql(true); });",
              "pm.test('Hay al menos un ejercicio', function () { pm.expect(rows.length).to.be.above(0); });",
              "pm.collectionVariables.set('firstExerciseId', rows[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03. GET /exercises/{id}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/exercises/{{firstExerciseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "exercises",
            "{{firstExerciseId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Exercise detail 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "const expectedId = Number(pm.collectionVariables.get('firstExerciseId'));",
              "pm.test('Id coincide', function () { pm.expect(data.id).to.eql(expectedId); });",
              "pm.test('Tiene title', function () { pm.expect(data.title).to.be.a('string'); });",
              "pm.test('public_test_cases es array', function () { pm.expect(Array.isArray(data.public_test_cases)).to.eql(true); });"
            ]
          }
        }
      ]
    }
  ]
}
